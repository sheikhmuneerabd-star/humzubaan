{
  "manifest_version": 3,
  "name": "Humzubaan",
  "version": "0.1.0",
  "description": "Fiverr ke messages Urdu/Roman Urdu mein samjhein aur English mein reply banayen.",
  "action": { "default_popup": "popup.html", "default_title": "Humzubaan" },
  "background": { "service_worker": "background.js" },
