{
  "manifest_version": 3,
  "name": "Humzubaan",
  "version": "0.2.0",
  "description": "Fiverr ke messages Urdu/Roman Urdu mein samjhein aur English mein reply banayen.",
  "action": { "default_popup": "popup.html", "default_title": "Humzubaan" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://www.fiverr.com/*", "https://fiverr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}